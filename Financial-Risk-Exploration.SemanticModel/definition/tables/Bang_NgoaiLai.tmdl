	partition Bang_NgoaiLai = calculated
		mode: import
		source =
				
				VAR _Base =
				    UNION (
				        ROW (
				            "Tỷ số",           "Thanh toán hiện hành (TSNH / Nợ NH)",
				            "Ngưỡng dưới",     VAR _q1 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.25 ) VAR _q3 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.75 ) VAR _i = _q3 - _q1 RETURN _q1 - 1.5 * _i,
				            "Ngưỡng trên",     VAR _q1 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.25 ) VAR _q3 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.75 ) VAR _i = _q3 - _q1 RETURN _q3 + 1.5 * _i,
				            "Ngoại lai dưới",  VAR _q1 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.25 ) VAR _q3 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.75 ) VAR _i = _q3 - _q1 VAR _l = _q1 - 1.5 * _i VAR _c = COUNTROWS ( FILTER ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio] < _l ) ) RETURN FORMAT ( COALESCE ( _c, 0 ), "#,0" ),
				            "Ngoại lai trên",  VAR _q1 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.25 ) VAR _q3 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.75 ) VAR _i = _q3 - _q1 VAR _u = _q3 + 1.5 * _i VAR _c = COUNTROWS ( FILTER ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio] > _u ) ) RETURN FORMAT ( COALESCE ( _c, 0 ), "#,0" ),
				            "Tỷ lệ ngoại lai", VAR _q1 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.25 ) VAR _q3 = PERCENTILEX.INC ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio], 0.75 ) VAR _i = _q3 - _q1 VAR _l = _q1 - 1.5 * _i VAR _u = _q3 + 1.5 * _i VAR _b = COUNTROWS ( FILTER ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio] < _l ) ) VAR _a = COUNTROWS ( FILTER ( 'FactBankruptcy', 'FactBankruptcy'[Liquidity_Ratio] > _u ) ) VAR _p = DIVIDE ( _b + _a, COUNTROWS ( 'FactBankruptcy' ) ) VAR _s = FORMAT ( ROUND ( COALESCE ( _p, 0 ) * 100, 1 ), "0.0" ) RETURN SUBSTITUTE ( _s, ".", "," ) & "%",
				            "Min",             MIN ( 'FactBankruptcy'[Liquidity_Ratio] ),
				            "Max",             MAX ( 'FactBankruptcy'[Liquidity_Ratio] )
