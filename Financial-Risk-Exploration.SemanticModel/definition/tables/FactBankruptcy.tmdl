	column Company_Year =
			
			FactBankruptcy[MaCongTy] & "-" &
			FORMAT(FactBankruptcy[Nam], "0")
		lineageTag: b99c929d-4994-44ce-8bb6-e5c7a091b517
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column GiaiDoan = ```
			
			SWITCH (
			    TRUE (),
			    FactBankruptcy[Nam] <= 2002, "1999–2002",
			    FactBankruptcy[Nam] <= 2007, "2003–2007",
			    FactBankruptcy[Nam] <= 2010, "2008–2010",
			    "2011–2018"
			)
			
			```
		lineageTag: 04a1274c-ea4a-4646-8004-7da97a741977
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Leverage_Bin = ```
			
			SWITCH (
			    TRUE (),
			    FactBankruptcy[Leverage_Ratio] < 0.3, "< 0,3",
			    FactBankruptcy[Leverage_Ratio] < 0.5, "0,3 – 0,5",
			    FactBankruptcy[Leverage_Ratio] < 0.7, "0,5 – 0,7",
			    FactBankruptcy[Leverage_Ratio] < 0.9, "0,7 – 0,9",
			    FactBankruptcy[Leverage_Ratio] < 1.0, "0,9 – 1,0",
			    FactBankruptcy[Leverage_Ratio] < 1.5, "1,0 – 1,5",
			    "≥ 1,5"
			)
			
			```
		lineageTag: 32ca62bc-c696-41c2-8408-a78af65ba927
		summarizeBy: none
		sortByColumn: Leverage_Order

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Leverage_Order = ```
			
			SWITCH (
			    TRUE (),
			    FactBankruptcy[Leverage_Ratio] < 0.3, 1,
			    FactBankruptcy[Leverage_Ratio] < 0.5, 2,
			    FactBankruptcy[Leverage_Ratio] < 0.7, 3,
			    FactBankruptcy[Leverage_Ratio] < 0.9, 4,
			    FactBankruptcy[Leverage_Ratio] < 1.0, 5,
			    FactBankruptcy[Leverage_Ratio] < 1.5, 6,
			    7
			)
			
			```
		formatString: 0
		lineageTag: adcaf643-e7cc-4348-bcb7-372fcd43236e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Nhom_PS = ```
			
			SWITCH (
			    TRUE (),
			    FactBankruptcy[TrangThaiPhaSan] = "alive",
			        "1. Công ty không phá sản",
			    FactBankruptcy[SoNamTruocPS] >= 3,
			        "2. Phá sản, ≥ 3 năm trước năm cuối",
			    FactBankruptcy[SoNamTruocPS] >= 1,
			        "3. Phá sản, 1–2 năm trước năm cuối",
			    "4. Năm trước phá sản"
			)
			
			```
		lineageTag: 1c9c20e5-63eb-4ef5-9292-16cc617e2807
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CS_NH = ```
			
			MAX (
			    0,
			    DIVIDE (
			        FactBankruptcy[NoNganHan],
			        FactBankruptcy[TongTaiSan]
			    )
			)
			
			```
		lineageTag: 2cfa3f54-af09-48c8-82df-2a7896f5a270
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CS_DH = ```
			
			MAX (
			    0,
			    DIVIDE (
			        FactBankruptcy[NoDaiHan],
			        FactBankruptcy[TongTaiSan]
			    )
			)
			
			```
		lineageTag: c8eca17e-847f-4f95-933d-d1aed807298b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CS_Khac = ```
			
			MAX (
			    0,
			    FactBankruptcy[Leverage_Ratio]
			        - DIVIDE (
			            FactBankruptcy[NoNganHan],
			            FactBankruptcy[TongTaiSan]
			        )
			        - DIVIDE (
			            FactBankruptcy[NoDaiHan],
			            FactBankruptcy[TongTaiSan]
			        )
			)
			
			```
		lineageTag: 04176946-008b-4df1-a0d1-0ebc113b0fbd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CS_VCSH = ```
			
			MAX (
			    0,
			    1 - FactBankruptcy[Leverage_Ratio]
			)
			
			```
		lineageTag: 96125a59-7a5e-4de1-b8c7-d55b8c445612
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CS_Tong = ```
			
			FactBankruptcy[CS_NH]
			    + FactBankruptcy[CS_DH]
			    + FactBankruptcy[CS_Khac]
			    + FactBankruptcy[CS_VCSH]
			
			```
		lineageTag: 55299ecc-033d-469c-b0b6-5c36ad0a34db
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Decile_VonHoa = ```
			
			VAR _Rank =
			    RANKX (
			        ALL ( FactBankruptcy ),
			        FactBankruptcy[VonHoaThiTruong],
			        ,
			        ASC,
			        DENSE
			    )
			VAR _N =
			    COUNTROWS (
			        FILTER (
			            ALL ( FactBankruptcy ),
			            NOT ISBLANK ( FactBankruptcy[VonHoaThiTruong] )
			        )
			    )
			RETURN
			    IF (
			        ISBLANK ( FactBankruptcy[VonHoaThiTruong] ),
			        BLANK (),
			        MIN ( 10, MAX ( 1, ROUNDUP ( DIVIDE ( _Rank * 10, _N ), 0 ) ) )
			    )
			
			```
		lineageTag: e1b313b0-2af6-4dbb-aad0-3c931e8d3711
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition FactBankruptcy = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\tuyet\OneDrive\Máy tính\trực quan hóa\New folder\american_bankruptcy_clean.csv"),[Delimiter=",", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Use First Row as Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Change Type" = Table.TransformColumnTypes(
				    #"Use First Row as Headers",
				    {
				        {"MaCongTy", type text},
				        {"TrangThaiPhaSan", type text},
				        {"Nam", Int64.Type},
				
				        {"TaiSanNganHan", type number},
				        {"GiaVonHangBan", type number},
				        {"KhauHao", type number},
				        {"EBITDA", type number},
				        {"HangTonKho", type number},
				        {"LoiNhuanRong", type number},
				        {"PhaiThu", type number},
				        {"VonHoaThiTruong", type number},
				        {"DoanhThuThuan", type number},
				        {"TongTaiSan", type number},
				        {"NoDaiHan", type number},
				        {"EBIT", type number},
				        {"LoiNhuanGop", type number},
				        {"NoNganHan", type number},
				        {"LoiNhuanGiuLai", type number},
				        {"TongDoanhThu", type number},
				        {"TongNoPhaiTra", type number},
				        {"ChiPhiHoatDong", type number},
				
				        {"NhanNamTruoc", type text},
				        {"PhaSanNamToi", Int64.Type},
				        {"SoNamTruocPS", Int64.Type}
				    }
				),
				    #"Added Custom" = Table.AddColumn(#"Change Type", "Liquidity_Ratio", each if [NoNganHan] <> 0
				then [TaiSanNganHan] / [NoNganHan]
				else null),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Leverage_Ratio", each if [TongTaiSan] <> 0
				then [TongNoPhaiTra] / [TongTaiSan]
				else null),
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "ROA", each if [TongTaiSan] <> 0
				then [LoiNhuanRong] / [TongTaiSan]
				else null),
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Retained_Earnings_Ratio", each if [TongTaiSan] <> 0
				then [LoiNhuanGiuLai] / [TongTaiSan]
				else null),
				    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "CurrentAssets_Ratio", each if [TongTaiSan] <> 0
				then [TaiSanNganHan] / [TongTaiSan]
				else null),
				    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "Log_TotalAssets", each if [TongTaiSan] > 0
				then Number.Log10([TongTaiSan])
				else null),
				    #"Added Custom6" = Table.AddColumn(#"Added Custom5", "MarketValue_Liabilities", each if [TongNoPhaiTra] > 0 and [VonHoaThiTruong] > 0
				then Number.Log10([VonHoaThiTruong] / [TongNoPhaiTra])
				else null),
				    #"Added Custom7" = Table.AddColumn(#"Added Custom6", "Leverage_Group", each if [Leverage_Ratio] > 1
				then "TL.TA > 1"
				else "TL.TA ≤ 1"),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom7",{{"Liquidity_Ratio", type number}, {"Leverage_Ratio", type number}, {"ROA", type number}, {"Retained_Earnings_Ratio", type number}, {"CurrentAssets_Ratio", type number}, {"Log_TotalAssets", type number}, {"MarketValue_Liabilities", type number}, {"Leverage_Group", type text}}),
				    #"Added Custom8" = Table.AddColumn(#"Changed Type", "Inv_TA", each if [TongTaiSan] <> 0
				then [HangTonKho] / [TongTaiSan]
				else null)
				in
				    #"Added Custom8"

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

