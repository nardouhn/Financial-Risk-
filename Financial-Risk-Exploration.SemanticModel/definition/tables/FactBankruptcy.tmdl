table FactBankruptcy
	lineageTag: 39884835-9f89-40ac-adad-2651d23b1aed

	measure 'Total Records' =
			
			COUNTROWS(FactBankruptcy)
		formatString: 0
		lineageTag: 2b48b9e2-6106-4056-a9ef-577899bfa92a

	measure 'Total Companies' =
			
			DISTINCTCOUNT(FactBankruptcy[MaCongTy])
		formatString: 0
		lineageTag: 03a1962e-fec0-4575-a1ba-2e93e69c16bb

	measure 'Failed Records' =
			
			CALCULATE(
			    COUNTROWS(FactBankruptcy),
			    FactBankruptcy[TrangThaiPhaSan] = "failed"
			)
		formatString: 0
		lineageTag: cbbe91e1-2e2c-481f-81ff-910ace7a0c82

	measure 'Alive Records' =
			
			CALCULATE(
			    COUNTROWS(FactBankruptcy),
			    FactBankruptcy[TrangThaiPhaSan] = "alive"
			)
		formatString: 0
		lineageTag: c49cede4-944a-4ee3-b35c-dd67f899f9e6

	measure 'Bankruptcy Rate' =
			
			DIVIDE(
			    [Failed Records],
			    [Total Records],
			    0
			)
		lineageTag: 9abd76c7-2ff9-41d6-a5f1-e4beb8e8e243

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Min Year' =
			
			MIN(FactBankruptcy[Nam])
		formatString: 0
		lineageTag: 8339e98a-f98e-4a91-8e44-74383c13bf6f

	measure 'Max Year' =
			
			MAX(FactBankruptcy[Nam])
		formatString: 0
		lineageTag: 390edee9-9713-4010-8e7a-6048429c9443

	measure 'Year Range' =
			
			FORMAT([Min Year], "0") & " – " & FORMAT([Max Year], "0")
		lineageTag: 4db08915-c0b4-491e-b608-fcb30e7e7a5d

	measure 'Average Liquidity' =
			
			AVERAGE(FactBankruptcy[Liquidity_Ratio])
		lineageTag: 3e792d9b-0136-43a6-9b62-f56c66dd6c3a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Leverage' =
			
			AVERAGE(FactBankruptcy[Leverage_Ratio])
		lineageTag: f642ac09-4079-4f0b-81e3-996228039d8d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average ROA' =
			
			AVERAGE(FactBankruptcy[ROA])
		lineageTag: 2a60c33e-15b1-4048-93fd-fb2823d7819f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Retained Earnings' =
			
			AVERAGE(FactBankruptcy[Retained_Earnings_Ratio])
		lineageTag: b27e5887-5dd1-49a2-9623-69bfc7a61e7e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TLTA Above 1 Count' =
			
			CALCULATE(
			    COUNTROWS(FactBankruptcy),
			    FactBankruptcy[Leverage_Ratio] > 1
			)
		formatString: 0
		lineageTag: 1a7ca094-0542-4c4a-a823-167baad5f42e

	measure 'Bankruptcy Rate TLTA > 1' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(FactBankruptcy),
			        FactBankruptcy[Leverage_Ratio] > 1,
			        FactBankruptcy[TrangThaiPhaSan] = "failed"
			    ),
			    CALCULATE(
			        COUNTROWS(FactBankruptcy),
			        FactBankruptcy[Leverage_Ratio] > 1
			    ),
			    0
			)
		lineageTag: 338dc07d-7dbf-4f4e-887d-6db8e5187cb3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Bankruptcy Rate TLTA <' =
			1 =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(FactBankruptcy),
			        FactBankruptcy[Leverage_Ratio] <= 1,
			        FactBankruptcy[TrangThaiPhaSan] = "failed"
			    ),
			    CALCULATE(
			        COUNTROWS(FactBankruptcy),
			        FactBankruptcy[Leverage_Ratio] <= 1
			    ),
			    0
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: b478764a-93e5-46c5-abe2-61905bedf4bd

	measure 'Average Total Assets' =
			
			AVERAGE(FactBankruptcy[TongTaiSan])
		lineageTag: 5e1b61d9-a312-4105-9065-4555612d7d7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Market Value' =
			
			AVERAGE(FactBankruptcy[VonHoaThiTruong])
		lineageTag: 83616cdc-b46e-4380-aaec-82d41544848f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

