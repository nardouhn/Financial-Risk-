	measure 'Rate theo Decile TS' = ```
			
			VAR k =
			    SELECTEDVALUE ( dim_decile[Value] )
			VAR lo =
			    IF (
			        k = 1,
			        -1E+99,
			        CALCULATE (
			            PERCENTILE.INC (
			                FactBankruptcy[TongTaiSan],
			                ( k - 1 ) / 10
			            ),
			            REMOVEFILTERS ( FactBankruptcy )
			        )
			    )
			VAR hi =
			    CALCULATE (
			        PERCENTILE.INC (
			            FactBankruptcy[TongTaiSan],
			            k / 10
			        ),
			        REMOVEFILTERS ( FactBankruptcy )
			    )
			RETURN
			    CALCULATE (
			        [Bankruptcy Rate],
			        FILTER (
			            ALL ( FactBankruptcy[TongTaiSan] ),
			            FactBankruptcy[TongTaiSan] > lo
			                && FactBankruptcy[TongTaiSan] <= hi
			        )
			    )
			
			```
		lineageTag: 66fbf9e4-c895-4e66-b8b0-1d67d6270836

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rate theo Decile VonHoa' = ```
			
			VAR k =
			    SELECTEDVALUE ( dim_decile[Value] )
			VAR lo =
			    IF (
			        k = 1,
			        -1E+99,
			        CALCULATE (
			            PERCENTILE.INC (
			                FactBankruptcy[VonHoaThiTruong],
			                ( k - 1 ) / 10
			            ),
			            REMOVEFILTERS ( FactBankruptcy )
			        )
			    )
			VAR hi =
			    CALCULATE (
			        PERCENTILE.INC (
			            FactBankruptcy[VonHoaThiTruong],
			            k / 10
			        ),
			        REMOVEFILTERS ( FactBankruptcy )
			    )
			RETURN
			    CALCULATE (
			        [Bankruptcy Rate],
			        FILTER (
			            ALL ( FactBankruptcy[VonHoaThiTruong] ),
			            FactBankruptcy[VonHoaThiTruong] > lo
			                && FactBankruptcy[VonHoaThiTruong] <= hi
			        )
			    )
			
			```
		lineageTag: 30c38e04-2ab2-421b-9d78-86ae22b7a17d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nguong Top10' = ```
			
			CALCULATE (
			    PERCENTILE.INC (
			        FactBankruptcy[TongTaiSan],
			        0.9
			    ),
			    REMOVEFILTERS ( FactBankruptcy )
			)
			
			```
		lineageTag: 399913a5-e6b6-4414-b086-4af5644ad5b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Med Top10' = ```
			
			VAR th = [Nguong Top10]
			RETURN
			    CALCULATE (
			        [Med Chon],
			        FILTER (
			            ALL ( FactBankruptcy[TongTaiSan] ),
			            FactBankruptcy[TongTaiSan] >= th
			        )
			    )
			
			```
		lineageTag: f4eff24b-0e16-4a80-8bde-5ca9966bc558

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Med Con Lai' = ```
			
			VAR th = [Nguong Top10]
			RETURN
			    CALCULATE (
			        [Med Chon],
			        FILTER (
			            ALL ( FactBankruptcy[TongTaiSan] ),
			            FactBankruptcy[TongTaiSan] < th
			        )
			    )
			
			```
		lineageTag: 382c36ec-7afb-49fc-a2bb-e4b5f717d91b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Chenh Lech' = ```
			
			[Med Top10] - [Med Con Lai]
			
			```
		lineageTag: b8a02e82-b9ff-4f8d-9fe6-1b3bbe410c20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Med Chon Alive' = ```
			
			CALCULATE (
			    [Med Chon All],
			    FactBankruptcy[TrangThaiPhaSan] = "alive",
			    REMOVEFILTERS ( FactBankruptcy[SoNamTruocPS] )
			)
			
			
			
