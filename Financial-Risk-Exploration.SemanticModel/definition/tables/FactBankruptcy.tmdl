	partition FactBankruptcy = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\tuyet\OneDrive\Máy tính\trực quan hóa\american_bankruptcy_clean.csv"),[Delimiter=",", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Use First Row as Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Change Type" = Table.TransformColumnTypes(
				    #"Use First Row as Headers",
				    {
				        {"MaCongTy", type text},
				        {"TrangThaiPhaSan", type text},
				        {"Nam", Int64.Type},
				
				        {"TaiSanNganHan", type number},
				        {"GiaVonHangBan", type number},
				        {"KhauHao", type number},
				        {"EBITDA", type number},
				        {"HangTonKho", type number},
				        {"LoiNhuanRong", type number},
				        {"PhaiThu", type number},
				        {"VonHoaThiTruong", type number},
				        {"DoanhThuThuan", type number},
				        {"TongTaiSan", type number},
				        {"NoDaiHan", type number},
				        {"EBIT", type number},
				        {"LoiNhuanGop", type number},
				        {"NoNganHan", type number},
				        {"LoiNhuanGiuLai", type number},
				        {"TongDoanhThu", type number},
				        {"TongNoPhaiTra", type number},
				        {"ChiPhiHoatDong", type number},
				
				        {"NhanNamTruoc", type text},
				        {"PhaSanNamToi", Int64.Type},
				        {"SoNamTruocPS", Int64.Type}
				    }
				),
				    #"Added Custom" = Table.AddColumn(#"Change Type", "Liquidity_Ratio", each if [NoNganHan] <> 0
				then [TaiSanNganHan] / [NoNganHan]
				else null),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Leverage_Ratio", each if [TongTaiSan] <> 0
				then [TongNoPhaiTra] / [TongTaiSan]
				else null),
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "ROA", each if [TongTaiSan] <> 0
				then [LoiNhuanRong] / [TongTaiSan]
				else null),
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Retained_Earnings_Ratio", each if [TongTaiSan] <> 0
				then [LoiNhuanGiuLai] / [TongTaiSan]
				else null),
				    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "CurrentAssets_Ratio", each if [TongTaiSan] <> 0
				then [TaiSanNganHan] / [TongTaiSan]
				else null),
				    #"Added Custom5" = Table.AddColumn(#"Added Custom4", "Log_TotalAssets", each if [TongTaiSan] > 0
				then Number.Log10([TongTaiSan])
				else null),
				    #"Added Custom6" = Table.AddColumn(#"Added Custom5", "MarketValue_Liabilities", each if [TongNoPhaiTra] > 0 and [VonHoaThiTruong] > 0
				then Number.Log10([VonHoaThiTruong] / [TongNoPhaiTra])
				else null),
				    #"Added Custom7" = Table.AddColumn(#"Added Custom6", "Leverage_Group", each if [Leverage_Ratio] > 1
				then "TL.TA > 1"
				else "TL.TA ≤ 1"),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom7",{{"Liquidity_Ratio", type number}, {"Leverage_Ratio", type number}, {"ROA", type number}, {"Retained_Earnings_Ratio", type number}, {"CurrentAssets_Ratio", type number}, {"Log_TotalAssets", type number}, {"MarketValue_Liabilities", type number}, {"Leverage_Group", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

