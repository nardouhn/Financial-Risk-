	column 'Log_TotalAssets (bins)' =
			IF(
				ISBLANK('FactBankruptcy'[Log_TotalAssets]),
				BLANK(),
				IF(
					'FactBankruptcy'[Log_TotalAssets] >= 0,
					ROUNDDOWN('FactBankruptcy'[Log_TotalAssets] / 0.5, 0) * 0.5,
					ROUNDUP('FactBankruptcy'[Log_TotalAssets] / 0.5, 0) * 0.5
				)
			)
		lineageTag: 3ed77f34-6f93-4812-b96e-097fdeff0065
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
				  "groupedColumns": [
				    {
				      "Column": {
				        "Expression": {
				          "SourceRef": {
				            "Entity": "FactBankruptcy"
				          }
				        },
				        "Property": "Log_TotalAssets"
				      }
				    }
				  ],
				  "binningMetadata": {
				    "binSize": {
				      "value": 0.5,
				      "unit": 0
				    }
				  }
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"f","Entity":"FactBankruptcy"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"Log_TotalAssets"}}],"BinItem":{"Expression":{"Floor":{"Expression":{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"Log_TotalAssets"}},"Size":0.5}}}}

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Size_Group =
			
			SWITCH(
			    TRUE(),
			    FactBankruptcy[Log_TotalAssets] < 2, "Small",
			    FactBankruptcy[Log_TotalAssets] < 3, "Medium",
			    "Large"
			)
		lineageTag: bf4a358b-35f1-4a96-b62e-e383bd7efba1
