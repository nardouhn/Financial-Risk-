		lineageTag: b26eafe2-47b4-4f38-a26d-6e58c034dd05

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Med Chon All' = ```
			
			SWITCH (
			    SELECTEDVALUE ( TySo_Chon[TySo], "Leverage_Ratio" ),
			    "MarketValue_Liabilities", MEDIAN ( FactBankruptcy[MarketValue_Liabilities] ),
			    "Leverage_Ratio", MEDIAN ( FactBankruptcy[Leverage_Ratio] ),
			    "ROA", MEDIAN ( FactBankruptcy[ROA] ),
			    "Liquidity_Ratio", MEDIAN ( FactBankruptcy[Liquidity_Ratio] ),
			    "Retained_Earnings_Ratio", MEDIAN ( FactBankruptcy[Retained_Earnings_Ratio] ),
			    "CurrentAssets_Ratio", MEDIAN ( FactBankruptcy[CurrentAssets_Ratio] ),
			    "Log_TotalAssets", MEDIAN ( FactBankruptcy[Log_TotalAssets] )
			)
			
			```
		lineageTag: 3767c51c-d5e9-4cc1-bb0c-2d359fc77c9e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

