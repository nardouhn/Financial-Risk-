		formatString: 0
		lineageTag: 1a7ca094-0542-4c4a-a823-167baad5f42e

	measure 'Bankruptcy Rate TLTA > 1' =
			
			DIVIDE (
			    CALCULATE ( SUM ( FactBankruptcy[PhaSanNamToi] ), FactBankruptcy[Leverage_Ratio] > 1 ),
			    CALCULATE ( COUNTROWS ( FactBankruptcy ),         FactBankruptcy[Leverage_Ratio] > 1 )
			)
		lineageTag: 338dc07d-7dbf-4f4e-887d-6db8e5187cb3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Bankruptcy Rate TLTA < 1' =
			
			DIVIDE (
			    CALCULATE ( SUM ( FactBankruptcy[PhaSanNamToi] ), FactBankruptcy[Leverage_Ratio] <= 1 ),
			    CALCULATE ( COUNTROWS ( FactBankruptcy ),         FactBankruptcy[Leverage_Ratio] <= 1 )
			)
		lineageTag: b478764a-93e5-46c5-abe2-61905bedf4bd

